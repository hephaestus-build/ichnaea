{
  "name": "@hephaestus-build/ichnaea-contracts",
  "version": "0.0.0",
  "description": "Ichnaea record contracts: zod schemas, the normative JSON Schema 2020-12 files, fixtures and canonical hashing.",
  "keywords": [
    "evaluation",
    "genai",
    "json-schema",
    "llm",
    "statistics",
    "zod"
  ],
  "homepage": "https://github.com/hephaestus-build/ichnaea#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hephaestus-build/ichnaea.git",
    "directory": "packages/contracts"
  },
  "files": [
    "README.md",
    "fixtures",
    "majors.json",
    "schemas",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json",
    "./fixtures/*": "./fixtures/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate-schemas.ts && node scripts/write-fixtures.ts",
    "api": "node scripts/api-report.ts --local",
    "check:api": "node scripts/api-report.ts"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}
