{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // zod is the authoring source of the contracts. Under isolatedDeclarations every exported
    // schema would need its full zod type written out by hand: a second copy of each schema.
    // Declarations are still emitted; a committed API report will gate their changes.
    "isolatedDeclarations": false
  },
  "include": ["src", "test", "scripts"]
}
