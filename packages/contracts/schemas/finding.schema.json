{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:finding:1",
  "title": "ichnaea.finding/1",
  "description": "A confirmed failure with pointers, promotable to a case.",
  "x-ichnaea-stability": "development",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.finding/1",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "monitor",
        "canary",
        "check",
        "triage",
        "manual"
      ],
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$"
      },
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "pointers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "x-ichnaea-data": {
        "class": "pseudonymous",
        "identifier": "quasi",
        "egress": [],
        "retention": "subject"
      }
    },
    "failureClass": {
      "type": "string",
      "minLength": 1,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "confirmerRole": {
      "type": "string",
      "minLength": 1,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "promotion": {
      "type": "string",
      "enum": [
        "none",
        "synthetic",
        "consented",
        "rejected"
      ],
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "linkedCase": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "source",
    "trials",
    "pointers",
    "failureClass",
    "promotion"
  ],
  "additionalProperties": false
}
