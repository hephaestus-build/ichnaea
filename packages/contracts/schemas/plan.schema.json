        "maxCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none"
          }
        },
        "monthlyRemaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none"
          }
        }
      },
      "required": [
        "worstCaseCalls",
        "maxCalls"
