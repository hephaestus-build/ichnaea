                "required": [
                  "nonFinite"
                ]
              }
            ],
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "sampledCasesFloor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "nonFinite": {
                    "type": "string",
                    "enum": [
                      "nan",
                      "inf",
                      "-inf"
                    ],
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none"
                    }
                  }
                },
                "required": [
                  "nonFinite"
                ]
              }
            ],
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "assumption": {
            "type": "string",
            "minLength": 1,
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "decidable": {
            "type": "boolean",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          }
        },
        "required": [
          "measure",
          "applicableCases",
          "replicates",
          "margin",
          "mde",
          "floor",
          "assumption",
          "decidable"
        ]
      }
