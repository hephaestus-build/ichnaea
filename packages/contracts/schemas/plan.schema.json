            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "margin": {
            "type": "number",
            "minimum": 0,
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "mde": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "nonFinite": {
                    "type": "string",
                    "enum": [
                      "nan",
                      "inf",
                      "-inf"
                    ],
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none"
                    }
                  }
                },
                "required": [
                  "nonFinite"
                ]
              }
            ],
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "floor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "nonFinite": {
                    "type": "string",
                    "enum": [
                      "nan",
                      "inf",
                      "-inf"
                    ],
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none"
                    }
                  }
