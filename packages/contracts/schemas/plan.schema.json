      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "ichnaea": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    }
  },
  "required": [
    "schema",
    "suite",
    "suiteVersion",
    "suiteDigest",
    "caseSet",
    "caseSetDigest",
    "trigger",
    "mode",
    "estimand",
    "alpha",
    "replicates",
    "arms",
    "measures",
    "power",
    "budget",
    "trials",
    "seed",
    "createdAt",
    "ichnaea"
  ]
}
