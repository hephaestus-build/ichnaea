      "maximum": 9007199254740991,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "arms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "base",
              "candidate"
            ],
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "configuration": {
