        "code",
        "configuration",
        "configuration-outside",
        "new-model",
        "silent-change",
        "case-set",
        "judge",
        "dependency",
        "framework",
        "data",
        "production-signal",
        "manual"
      ],
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "decision",
        "estimate-only"
