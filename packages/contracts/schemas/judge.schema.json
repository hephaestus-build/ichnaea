{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:judge:1",
  "title": "ichnaea.judge/1",
  "description": "A model-based instrument for a measure, defined as data.",
  "x-ichnaea-stability": "development",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.judge/1",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9._-]*$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "evaluatorKind": {
      "type": "string",
      "enum": [
        "model",
        "human",
        "code"
      ],
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none"
          }
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none"
          }
        },
        "version": {
          "type": "string",
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none"
          }
        }
      },
      "required": [
        "provider",
        "id"
      ]
    },
    "endpointClass": {
      "type": "string",
      "minLength": 1,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "promptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "rubricDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "outputSchema": {
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      },
      "$ref": "#/$defs/JsonValue"
    },
    "outputKind": {
      "type": "string",
      "enum": [
        "binary",
        "levels",
        "pairwise"
      ],
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "swapOrder": {
      "type": "boolean",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "evaluatorKind",
    "model",
    "endpointClass",
    "promptDigest",
    "rubricDigest",
    "outputSchema",
    "outputKind",
    "parameters",
    "swapOrder",
    "repeats"
  ],
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
