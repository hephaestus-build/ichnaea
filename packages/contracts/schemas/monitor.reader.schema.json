{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:monitor:1:reader",
  "title": "ichnaea.monitor/1 (reader)",
  "description": "An online or scheduled check with an owner and an action.",
  "x-ichnaea-stability": "development",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.monitor/1",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "measure": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9._-]*$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "strata": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "sampling": {
      "type": "string",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "census",
        "random",
        "triage"
      ]
    },
    "statistic": {
      "type": "string",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "bernoulli-cusum",
        "poisson-cusum",
        "confidence-sequence",
        "age-threshold"
      ]
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      },
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "reference": {
      "type": "number",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "falseAlarmsPerYear": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "practicalMargin": {
      "type": "number",
      "minimum": 0,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "x-ichnaea-data": {
        "class": "personal",
        "identifier": "direct",
        "egress": [],
        "retention": "subject"
      }
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "severity": {
      "type": "string",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "info",
        "warning",
        "critical"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "measure",
    "sampling",
    "statistic",
    "parameters",
    "reference",
    "falseAlarmsPerYear",
    "practicalMargin",
    "owner",
    "action",
    "severity"
  ]
}
