{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:caseSet:1",
  "title": "ichnaea.caseSet/1",
  "description": "A versioned collection of cases identified by a digest.",
  "x-ichnaea-stability": "alpha",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.caseSet/1",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "description": {
      "type": "string",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none"
      }
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "pool": {
            "type": "string",
            "enum": [
              "development",
              "validation",
              "sealed",
              "promoted"
            ],
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none"
            }
          }
        },
        "required": [
          "id",
          "digest",
          "pool"
        ]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "digest",
    "cases"
  ]
}
