{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:caseSet:1",
  "title": "ichnaea.caseSet/1",
  "description": "A versioned collection of cases identified by a digest.",
  "x-ichnaea-stability": "alpha",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.caseSet/1",
      "description": "The record type and its major version.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
      "description": "The case set's identifier.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "A version label for people.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "description": {
      "type": "string",
      "description": "What the case set covers.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "The digest of the case entries. It identifies the case set, so a change to any case changes it.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
            "description": "The case's identifier.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "The digest of the case record.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "pool": {
            "type": "string",
            "enum": [
              "development",
              "validation",
              "sealed",
              "promoted"
            ],
            "description": "The pool that the case belongs to.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "description": "The family of variants that the case belongs to.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          }
        },
        "required": [
          "id",
          "digest",
          "pool"
        ],
        "additionalProperties": false
      },
      "description": "One entry for each case."
    }
  },
  "required": [
    "schema",
    "id",
    "digest",
    "cases"
  ],
  "additionalProperties": false
}
