{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:measureCard:1:reader",
  "title": "ichnaea.measureCard/1 (reader)",
  "description": "The definition of a measure.",
  "x-ichnaea-stability": "alpha",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.measureCard/1",
      "description": "The record type and its major version.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9._-]*$",
      "description": "The measure's identifier.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "The version of the measure's definition.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "construct": {
      "type": "string",
      "minLength": 1,
      "description": "What the measure is meant to capture.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "operationalDefinition": {
      "type": "string",
      "minLength": 1,
      "description": "How a value is computed from an answer.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "valueType": {
      "type": "string",
      "description": "The kind of value that the measure gives.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "binary",
        "proportion",
        "score",
        "level",
        "preference",
        "quantity"
      ]
    },
    "levels": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The ordered levels of a level measure.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "description": "The unit of a value.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "direction": {
      "type": "string",
      "description": "Whether a higher or a lower value is better.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "higher",
        "lower"
      ]
    },
    "scale": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "description": "The lowest possible value.",
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none",
            "egress": [
              "*"
            ],
            "retention": "record"
          }
        },
        "max": {
          "type": "number",
          "description": "The highest possible value.",
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none",
            "egress": [
              "*"
            ],
            "retention": "record"
          }
        }
      },
      "required": [
        "min",
        "max"
      ],
      "description": "The range of a score."
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "description": "Why the measure fits the decision that the suite supports.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "errorModel": {
      "type": "string",
      "minLength": 1,
      "description": "How the measure can be wrong.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "applicability": {
      "type": "string",
      "minLength": 1,
      "description": "Which cases the measure applies to.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "tier": {
      "type": "string",
      "description": "Primary measures decide the verdict. Secondary and diagnostic measures are reported.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "primary",
        "secondary",
        "diagnostic"
      ]
    },
    "composite": {
      "type": "boolean",
      "description": "True for a per-case composite of other measures. A composite is never a primary measure.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "unitOfEvaluation": {
      "type": "string",
      "description": "What one value is computed over: a turn, a trace, a session or an episode.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "turn",
        "trace",
        "session",
        "episode"
      ]
    },
    "establishes": {
      "type": "string",
      "minLength": 1,
      "description": "What a value of the measure establishes.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "computedBy": {
      "type": "string",
      "description": "Who computes the value: Ichnaea, the application or a judge.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      },
      "x-ichnaea-known": [
        "ichnaea",
        "application",
        "judge"
      ]
    },
    "judge": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9._-]*$",
      "description": "The judge that computes the value, when a judge does.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "tester": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Whether the measure passed its known-good and known-bad check.",
              "x-ichnaea-data": {
                "class": "none",
                "identifier": "none",
                "egress": [
                  "*"
                ],
                "retention": "record"
              },
              "x-ichnaea-known": [
                "passed",
                "failed"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "The digest of the check that ran.",
              "x-ichnaea-data": {
                "class": "none",
                "identifier": "none",
                "egress": [
                  "*"
                ],
                "retention": "record"
              }
            },
            "ranAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$",
              "description": "When the check ran.",
              "x-ichnaea-data": {
                "class": "none",
                "identifier": "none",
                "egress": [
                  "*"
                ],
                "retention": "record"
              }
            }
          },
          "required": [
            "status",
            "digest",
            "ranAt"
          ],
          "description": "The latest known-good and known-bad check of the measure."
        },
        "calibration": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The digest of the judge's calibration record.",
          "x-ichnaea-data": {
            "class": "none",
            "identifier": "none",
            "egress": [
              "*"
            ],
            "retention": "record"
          }
        }
      },
      "description": "The evidence that the measure works."
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "construct",
    "operationalDefinition",
    "valueType",
    "unit",
    "direction",
    "justification",
    "errorModel",
    "applicability",
    "tier",
    "unitOfEvaluation",
    "establishes",
    "computedBy"
  ]
}
