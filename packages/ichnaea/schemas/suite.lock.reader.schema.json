                "type": "string",
                "minLength": 1,
                "description": "The version.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
