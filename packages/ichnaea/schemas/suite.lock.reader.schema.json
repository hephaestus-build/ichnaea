                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The digest of what the judge is shown.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
