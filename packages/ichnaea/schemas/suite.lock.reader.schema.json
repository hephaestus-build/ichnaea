{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:suite.lock:1:reader",
  "title": "ichnaea.suite.lock/1 (reader)",
  "description": "The lock of a suite: the digests of its sources, instruments and measures, written by lock.",
  "x-ichnaea-stability": "alpha",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.suite.lock/1",
      "description": "The record type and its major version.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "suite": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
      "description": "The suite that the lock belongs to.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "suiteDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "The digest of the suite's canonical JSON.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "measurementDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "The digest of the parts of the suite that change what is measured.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "dataset": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
                    "description": "The dataset.",
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none",
                      "egress": [
                        "*"
                      ],
                      "retention": "record"
                    }
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The case file inside the dataset.",
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none",
                      "egress": [
                        "*"
                      ],
                      "retention": "record"
                    }
                  }
                },
                "required": [
                  "dataset",
                  "path"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The file.",
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none",
                      "egress": [
                        "*"
                      ],
                      "retention": "record"
                    }
                  }
                },
                "required": [
                  "file"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "git": {
                    "type": "object",
                    "properties": {
                      "repo": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The repository.",
                        "x-ichnaea-data": {
                          "class": "none",
                          "identifier": "none",
                          "egress": [
                            "*"
                          ],
                          "retention": "record"
                        }
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
                        "description": "The full commit.",
                        "x-ichnaea-data": {
                          "class": "none",
                          "identifier": "none",
                          "egress": [
                            "*"
                          ],
                          "retention": "record"
                        }
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The path in the repository.",
                        "x-ichnaea-data": {
                          "class": "none",
                          "identifier": "none",
                          "egress": [
                            "*"
                          ],
                          "retention": "record"
                        }
                      }
                    },
                    "required": [
                      "repo",
                      "commit"
                    ],
                    "description": "A git source."
                  }
                },
                "required": [
                  "git"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "https": {
                    "type": "object",
                    "properties": {
                      "host": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The host.",
                        "x-ichnaea-data": {
                          "class": "none",
                          "identifier": "none",
                          "egress": [
                            "*"
                          ],
                          "retention": "record"
                        }
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The path.",
                        "x-ichnaea-data": {
                          "class": "none",
                          "identifier": "none",
                          "egress": [
                            "*"
                          ],
                          "retention": "record"
                        }
                      }
                    },
                    "required": [
                      "host",
                      "path"
                    ],
                    "description": "An HTTPS source, by host and path."
                  }
                },
                "required": [
                  "https"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "command": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "The command.",
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none",
                      "egress": [
                        "*"
                      ],
                      "retention": "record"
                    }
                  },
                  "output": {
                    "type": "string",
                    "minLength": 1,
                    "description": "What the command wrote.",
                    "x-ichnaea-data": {
                      "class": "none",
                      "identifier": "none",
                      "egress": [
                        "*"
                      ],
                      "retention": "record"
                    }
                  }
                },
                "required": [
                  "command",
                  "output"
                ]
              }
            ],
            "description": "Where the source came from."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "The source's digest.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The source's size in bytes.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "pools": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "x-ichnaea-known": [
                "development",
                "validation",
                "sealed",
                "promoted"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": "The number of cases in each pool.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          }
        },
        "required": [
          "origin",
          "digest",
          "bytes",
          "pools"
        ]
      },
      "description": "Each case source."
    },
    "datasets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
            "description": "The dataset's commit, for a git dataset.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "place": {
            "type": "string",
            "description": "public only when the place answered an anonymous HTTPS request with 200; otherwise private.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            },
            "x-ichnaea-known": [
              "public",
              "private"
            ]
          }
        },
        "required": [
          "place"
        ]
      },
      "description": "Each dataset that the sources read."
    },
    "instruments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "files": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "The tree digest of the instrument's tracked files.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "image": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1,
                "description": "The image reference that the suite names.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The image's registry digest.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
            },
            "required": [
              "reference",
              "digest"
            ],
            "description": "The grading image."
          },
          "judge": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "description": "The model, with its revision.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "description": "The sampling parameters.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "prompt": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The prompt's digest.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "rubric": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The rubric's digest.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "inputsDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The digest of what the judge is shown.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
            },
            "required": [
              "model",
              "parameters",
              "prompt",
              "rubric",
              "inputsDigest"
            ],
            "description": "The judge identity, when the instrument is a model judge."
          },
          "imported": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "description": "The version.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "The digest.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
            },
            "required": [
              "version",
              "digest"
            ],
            "description": "An imported instrument's version and digest."
          }
        }
      },
      "description": "Each instrument's pin. A built-in scorer has none."
    },
    "measures": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "description": "Each measure definition's digest.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "registration": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The largest drop that the owner accepts. It applies to Pass.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "The role that owns the limit.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why the limit has this value.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          }
        },
        "required": [
          "limit",
          "owner",
          "reason"
        ]
      },
      "description": "A copy of the primary measures' limits, owners and reasons, derived from the suite."
    }
  },
  "required": [
    "schema",
    "suite",
    "suiteDigest",
    "measurementDigest",
    "sources",
    "instruments",
    "measures",
    "registration"
  ],
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
