{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:lock:1",
  "title": "ichnaea.lock/1",
  "description": "The case and instrument pins for the analysis plan.",
  "x-ichnaea-stability": "alpha",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ichnaea.lock/1",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "plan": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$",
            "description": "The case's identifier.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "The digest of the case record.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "pool": {
            "type": "string",
            "enum": [
              "development",
              "validation",
              "sealed",
              "promoted"
            ],
            "description": "The pool that the case belongs to.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "description": "The family of variants that the case belongs to.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          }
        },
        "required": [
          "id",
          "digest",
          "pool"
        ],
        "additionalProperties": false
      }
    },
    "instruments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    }
  },
  "required": [
    "schema",
    "plan",
    "cases",
    "instruments"
  ],
  "additionalProperties": false
}
