                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "x-ichnaea-data": {
                    "class": "none",
                    "identifier": "none",
                    "egress": [
                      "*"
                    ],
                    "retention": "record"
                  }
                },
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "judge": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
