            "required": [
              "item",
              "stratum",
              "configuration",
              "weight",
              "raters",
              "judge"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scale",
        "levels",
        "units"
      ],
      "additionalProperties": false,
      "x-ichnaea-data": {
        "class": "inherit",
        "identifier": "content",
        "egress": [
          "*"
        ],
        "retention": "subject"
      }
    }
  },
  "required": [
    "schema",
    "run",
    "study",
    "source",
    "registration",
    "dataClass",
    "scale",
    "judge",
    "values",
    "calibration"
  ],
  "additionalProperties": false
}
