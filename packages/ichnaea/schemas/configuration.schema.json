      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What the configuration is, for people.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "models": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "The role that the model plays, for example answer or rerank.",
