              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "provider": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "The value. It is never empty.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "pinned",
                  "declared"
                ],
                "description": "Whether the value is pinned or only declared.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
            },
            "required": [
              "value",
              "status"
            ],
            "additionalProperties": false,
            "description": "The model provider."
          },
          "id": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "The value. It is never empty.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "pinned",
                  "declared"
                ],
                "description": "Whether the value is pinned or only declared.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
            },
            "required": [
              "value",
              "status"
            ],
            "additionalProperties": false,
            "description": "The model ID."
          },
          "version": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "The value. It is never empty.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "pinned",
                  "declared"
                ],
                "description": "Whether the value is pinned or only declared.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
            },
            "required": [
              "value",
              "status"
            ],
            "additionalProperties": false,
            "description": "The model version, when the provider names one."
          },
          "route": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "The value. It is never empty.",
                "x-ichnaea-data": {
                  "class": "none",
                  "identifier": "none",
                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "pinned",
                  "declared"
