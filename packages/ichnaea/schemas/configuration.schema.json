                  "egress": [
                    "*"
                  ],
                  "retention": "record"
                }
              }
            },
            "required": [
              "value",
              "status"
            ],
            "additionalProperties": false,
            "description": "The route that the calls take, such as a deployment or a gateway route."
          }
