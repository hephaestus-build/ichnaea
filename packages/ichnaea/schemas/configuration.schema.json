      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            },
            "$ref": "#/$defs/JsonValue"
          },
          "status": {
            "type": "string",
            "enum": [
              "pinned",
              "observed",
              "declared",
              "uncontrollable"
            ],
            "description": "The control status of the value: pinned, observed, declared or uncontrollable.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          },
          "part": {
            "type": "string",
            "enum": [
              "code",
              "prompt",
              "model",
              "runtime",
              "parameter",
              "tool",
              "setting",
              "data",
              "other"
            ],
            "description": "The part of the system that the factor belongs to.",
            "x-ichnaea-data": {
              "class": "none",
              "identifier": "none",
              "egress": [
                "*"
              ],
              "retention": "record"
            }
          }
        },
        "required": [
          "value",
          "status",
          "part"
        ],
        "additionalProperties": false
      },
      "description": "Everything else that decides behavior, under dotted names such as code.commit or tool.retrieval.topK."
    },
    "label": {
      "type": "string",
      "description": "A short name for people.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    },
    "informational": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Values that do not decide behavior and never enter the identity, such as a provider fingerprint.",
      "x-ichnaea-data": {
        "class": "none",
        "identifier": "none",
        "egress": [
          "*"
        ],
        "retention": "record"
      }
    }
