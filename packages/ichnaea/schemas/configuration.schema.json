{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ichnaea:schema:configuration:1",
  "title": "ichnaea.configuration/1",
  "description": "A resolved system configuration with factor statuses.",
  "x-ichnaea-stability": "alpha",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
