{
  "schema": "ichnaea.config/1",
  "suites": [
    "suites/*/suite.ts"
  ],
  "datasets": {
    "answers-public": {
      "git": {
        "repo": "https://github.com/example/answers-eval",
        "commit": "9e2c1f0a4b7d3e6c8a1f2b5d7e9c0a3b6d8f1e2c"
      }
    },
    "answers-private": {
      "git": {
        "repo": "git@github.com:example/answers-eval-private.git",
        "commit": "41ab0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b"
      }
    }
  },
  "workers": {
    "chatbot": {
      "command": [
        "poetry",
        "run",
        "python",
        "-m",
        "evals.worker"
      ],
      "prepare": [
        "poetry",
        "install",
        "--no-root"
      ],
      "env": [
        {
          "name": "LLM_API_KEY",
          "secret": true
        }
      ],
      "endpoints": [
        "eu-llm"
      ],
      "capacity": 4
    }
  },
  "endpoints": {
    "eu-llm": {
      "concurrency": 8,
      "requestsPerMinute": 600
    }
  },
  "baselines": {
    "from": {
      "githubArtifact": {
        "workflow": "baseline.yml",
        "branch": "main"
      }
    },
    "freshness": "P7D"
  },
  "defaults": {
    "trials": 2,
    "mode": "fast"
  },
  "delivery": {
    "sinks": {
      "pr": {
        "kind": "github"
      },
      "il3": {
        "kind": "teams-workflow",
        "url": {
          "fromEnv": "IL3_TEAMS_WORKFLOW_URL"
        }
      }
    },
    "routes": [
      {
        "on": "compare",
        "profile": "pr",
        "to": [
          "pr"
        ]
      }
    ]
  },
  "privacy": {
    "homeKey": {
      "fromEnv": "ICHNAEA_HOME_KEY"
    },
    "consent": "/srv/eval/consent.jsonl",
    "governance": {
      "home": {
        "description": "evaluation job inside the deployment's cluster"
      },
      "purposes": {
        "PU-3": {
          "enabled": true,
          "basis": "consent",
          "record": "dpia/raters-2026.md"
        },
        "PU-7": {
          "enabled": true,
          "basis": "public-task",
          "record": "ropa/eval-at-home.md"
        }
      },
      "endpoints": {
        "eu-llm": {
          "provider": "example",
          "region": "eu",
          "purposes": [
            "PU-3",
            "PU-7"
          ]
        }
      },
      "retention": {
        "pseudonymous": "P180D",
        "personal": "P30D",
        "labels": {
          "study": "P3Y"
        }
      }
    }
  }
}
