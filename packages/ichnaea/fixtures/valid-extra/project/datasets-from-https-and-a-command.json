{
  "schema": "ichnaea.config/1",
  "suites": [
    "suites/*/suite.ts"
  ],
  "datasets": {
    "presigned": {
      "https": {
        "fromEnv": "CASES_URL"
      },
      "digest": "sha256:a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8a8"
    },
    "dvc": {
      "command": [
        "dvc",
        "pull",
        "data/answers.dvc"
      ],
      "output": "data/answers",
      "env": [
        "AWS_PROFILE"
      ]
    }
  },
  "workers": {
    "chatbot": {
      "command": [
        "poetry",
        "run",
        "python",
        "-m",
        "evals.worker"
      ],
      "prepare": [
        "poetry",
        "install",
        "--no-root"
      ],
      "env": [
        {
          "name": "LLM_API_KEY",
          "secret": true
        }
      ],
      "endpoints": [
        "eu-llm"
      ],
      "capacity": 4
    }
  },
  "endpoints": {
    "eu-llm": {
      "concurrency": 8,
      "requestsPerMinute": 600
    }
  },
  "baselines": {
    "from": {
      "githubArtifact": {
        "workflow": "baseline.yml",
        "branch": "main"
      }
    },
    "freshness": "P7D"
  },
  "defaults": {
    "trials": 2,
    "mode": "fast"
  },
  "delivery": {
    "sinks": {
      "pr": {
        "kind": "github"
      }
    },
    "routes": [
      {
        "on": "compare",
        "profile": "pr",
        "to": [
          "pr"
        ]
      }
    ]
  },
  "privacy": {
    "homeKey": {
      "fromEnv": "ICHNAEA_HOME_KEY"
    }
  }
}
