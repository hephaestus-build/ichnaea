{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  // scripts/api-report.ts emits the declarations to a temporary folder and sets, for each subpath,
  // the entry point, the report's name and the report's temporary folder there.
  "mainEntryPointFilePath": "<projectFolder>/index.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/api/"
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },
  "messages": {
    "extractorMessageReporting": {
      "default": { "logLevel": "warning" },
      "ae-missing-release-tag": { "logLevel": "none" },
      "ae-forgotten-export": { "logLevel": "error" },
      // Every public export and member has a doc comment (REQ-110).
      "ae-undocumented": { "logLevel": "error" }
    },
    // The reports gate the declarations. The statistics' doc comments use mathematical notation
    // (a < b, x > y) that TSDoc reads as markup; it is not part of any declaration.
    "tsdocMessageReporting": {
      "default": { "logLevel": "none" }
    }
  }
}
