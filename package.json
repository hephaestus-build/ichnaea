{
  "name": "ichnaea-workspace",
  "private": true,
  "description": "Ichnaea: statistically sound evaluation of GenAI applications, offline and online.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hephaestus-build/ichnaea.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "node scripts/typecheck.ts",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "lint": "oxlint --deny-warnings . && node scripts/check-purity.ts && node scripts/check-ai-sdk-boundary.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate": "pnpm -r --filter './packages/*' run generate",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:generated",
    "check:generated": "pnpm run generate && git diff --exit-code -- packages/*/schemas packages/*/fixtures",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.3.4"
}
