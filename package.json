{
  "bin": {
    "ichnaea": "./dist/core/bin.js"
  },
  "description": "Ichnaea: statistically sound evaluation of GenAI applications. Record contracts, statistics, plugin host, decision rule, reports and CLI.",
  "engines": {
    "node": ">=24.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./stats": {
      "types": "./dist/stats/index.d.ts",
      "default": "./dist/stats/index.js"
    },
    "./calibration": {
      "types": "./dist/calibration/index.d.ts",
      "default": "./dist/calibration/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/hephaestus-build/ichnaea#readme",
  "keywords": [
    "confidence-interval",
    "evaluation",
    "genai",
    "json-schema",
    "llm",
    "non-inferiority",
    "statistics",
    "zod"
  ],
  "license": "MIT",
  "name": "@tumaet/ichnaea",
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hephaestus-build/ichnaea.git",
    "directory": "packages/ichnaea"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.0"
}
