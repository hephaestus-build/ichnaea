{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-explicit-any": "error",
    "no-console": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_zod"]
      }
    ]
  },
  "ignorePatterns": ["dist", "coverage", "packages/*/schemas"]
}
