{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-explicit-any": "error",
    "no-console": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_zod"]
      }
    ]
  },
  "ignorePatterns": ["dist", "coverage", "packages/ichnaea/schemas"],
  "overrides": [
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "typescript/explicit-function-return-type": "error",
        "typescript/explicit-module-boundary-types": "error"
      }
    },
    // The boundaries between the areas of the package. The statistics import nothing outside
    // src/stats. Judge calibration imports only the statistics. The contracts import nothing
    // outside src/contracts but zod. The other areas import only the areas below them: core
    // imports contracts; decide imports contracts, stats and core; report imports contracts,
    // decide and core. Inside the package, and in the study scripts and the test support they
    // load, a module imports the file that defines what it uses, never an index.ts barrel: a
    // barrel is only a public entry of the package, and a study's provenance pins every module it
    // loads, so a barrel would pin every file it re-exports. For the same reason they never import
    // the package by its own name. The rule covers a dynamic import() of a literal too.
    // scripts/lint-boundaries.test.ts shows that a forbidden import fails.
    {
      "files": ["packages/ichnaea/scripts/stats/**", "packages/ichnaea/test/stats/support/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/index.ts"],
                "message": "A module imports the file that defines what it uses, never an index.ts barrel."
              },
              {
                "group": ["@*/ichnaea", "@*/ichnaea/**"],
                "message": "A module inside the package imports its files by path, never the package by its name."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ichnaea/src/stats/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./**", "**/index.ts"],
                "message": "src/stats imports only its own modules. A module imports the file that defines what it uses, never an index.ts barrel."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ichnaea/src/calibration/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./**", "!../stats/*.ts", "**/index.ts"],
                "message": "src/calibration imports only its own modules and src/stats. A module imports the file that defines what it uses, never an index.ts barrel."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ichnaea/src/contracts/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./**", "!zod", "**/index.ts"],
                "message": "src/contracts imports only its own modules and zod. A module imports the file that defines what it uses, never an index.ts barrel."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ichnaea/src/contracts/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./**", "!../*", "!zod", "../../**", "**/index.ts"],
                "message": "src/contracts imports only its own modules and zod. A module imports the file that defines what it uses, never an index.ts barrel."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ichnaea/src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../stats/**",
                  "!../stats/reduce.ts",
                  "../decide/**",
                  "../report/**",
                  "../index.ts",
                  "**/index.ts"
                ],
                "message": "src/core imports src/contracts and the trial reduction it applies on import. A module imports the file that defines what it uses, never an index.ts barrel."
              },
              {
                "group": ["@*/ichnaea", "@*/ichnaea/**"],
                "message": "A module inside the package imports its files by path, never the package by its name."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ichnaea/src/decide/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../report/**", "../index.ts", "**/index.ts"],
                "message": "src/decide imports only src/contracts, src/stats and src/core from the other areas. A module imports the file that defines what it uses, never an index.ts barrel."
              },
              {
                "group": ["@*/ichnaea", "@*/ichnaea/**"],
                "message": "A module inside the package imports its files by path, never the package by its name."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ichnaea/src/report/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../stats/**", "../index.ts", "**/index.ts"],
                "message": "src/report imports only src/contracts, src/decide and src/core from the other areas. A module imports the file that defines what it uses, never an index.ts barrel."
              },
              {
                "group": ["@*/ichnaea", "@*/ichnaea/**"],
                "message": "A module inside the package imports its files by path, never the package by its name."
              }
            ]
          }
        ]
      }
    }
  ]
}
